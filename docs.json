{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Firedrill",
  "description": "Stateful simulation and testing for action-taking AI agents",
  "seo": {
    "metatags": {
      "canonical": "https://docs.firedrill.run"
    }
  },
  "colors": {
    "primary": "#3157D5",
    "light": "#5272DE",
    "dark": "#5272DE"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "fonts": {
    "family": "Inter",
    "weight": 450,
    "heading": {
      "family": "Inter",
      "weight": 600
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "concepts/how-it-works",
              "reference/choose-a-workflow"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/tools",
              "concepts/world-state",
              "concepts/scenarios",
              "concepts/actors-personas",
              "concepts/drills-runs",
              "concepts/evidence-reset"
            ]
          },
          {
            "group": "Build a local world",
            "pages": [
              "guides/start-local-tools",
              "guides/install-tools",
              "guides/create-tool-package",
              "guides/project-files",
              "guides/tool-apps",
              "guides/import-data"
            ]
          },
          {
            "group": "Test and simulate",
            "pages": [
              "guides/connect-agent",
              "guides/run-first-drill",
              "guides/mock-dependencies",
              "guides/control-state-time",
              "guides/reusable-scenarios",
              "guides/callbacks",
              "guides/browser-testing",
              "guides/capture",
              "guides/results",
              "guides/ci"
            ]
          },
          {
            "group": "Coding agents",
            "pages": [
              "guides/coding-agents",
              "guides/firedrill-agent",
              "guides/tool-discovery"
            ]
          },
          {
            "group": "Firedrill Cloud",
            "pages": [
              "cloud/overview",
              "cloud/projects-builds",
              "cloud/sessions",
              "cloud/runs-evidence",
              "cloud/security"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/glossary",
              "reference/project-structure",
              "reference/tool-contract",
              "reference/local-inspector-api",
              "reference/compatibility",
              "reference/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "CLI",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "CLI",
            "pages": [
              "cli/overview",
              "cli/reference",
              "reference/troubleshooting"
            ]
          },
          {
            "group": "Tools",
            "pages": [
              "guides/tool-discovery",
              "guides/install-tools",
              "guides/create-tool-package"
            ]
          }
        ]
      },
      {
        "tab": "SDKs",
        "icon": "code",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "sdk/overview"
            ]
          },
          {
            "group": "Local TypeScript SDK",
            "pages": [
              "sdk/local-typescript",
              "guides/mock-dependencies",
              "guides/browser-testing"
            ]
          },
          {
            "group": "Local Python SDK",
            "pages": [
              "sdk/local-python"
            ]
          },
          {
            "group": "Cloud SDKs",
            "pages": [
              "sdk/cloud-typescript",
              "sdk/cloud-python",
              "sdk/errors"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "brackets-curly",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/overview",
              "api-reference/authentication"
            ]
          },
          {
            "group": "Control API",
            "openapi": "api-reference/openapi.json"
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/firedrill-tools",
          "icon": "github"
        },
        {
          "anchor": "firedrill.run",
          "href": "https://firedrill.run",
          "icon": "globe"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/firedrill-tools"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/quickstart"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "api": {
    "playground": {
      "display": "none"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/firedrill-tools"
    }
  }
}
